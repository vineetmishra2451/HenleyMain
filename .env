# ==============================================================================
# Henley — Environment Configuration
# Direct-to-Consumer Luxury Tea, Botanicals & Spices Platform
# ==============================================================================

APP_NAME="Henley"
APP_ENV=local
APP_KEY=base64:FYaoX/lSWqdOrdsYXzYjYr8xb1qnoWXmAFW/mVJWxuc=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_CURRENCY=INR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Database (PostgreSQL 16 only — no MySQL)
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=henley
DB_USERNAME=sail
DB_PASSWORD=password
FORWARD_DB_PORT=54320

# ------------------------------------------------------------------------------
# Redis & Session / Cache / Queue Drivers
# ------------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
FORWARD_REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
CACHE_PREFIX=henley_cache_

QUEUE_CONNECTION=redis

# ------------------------------------------------------------------------------
# Storage Disks (Cloudflare R2 via S3 Driver + Local Public for Dev)
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=public

# Cloudflare R2 Credentials (production object storage)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=henley-media
R2_ENDPOINT=https://account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://media.henleytea.com
R2_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------------------
# Mail Configuration (Mailpit for local testing)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="care@henleytea.com"
MAIL_FROM_NAME="${APP_NAME}"

FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

# ------------------------------------------------------------------------------
# Payment Gateway (Razorpay)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_placeholder

# ------------------------------------------------------------------------------
# Henley Commerce & Brand Financial Parameters (in Paise)
# ------------------------------------------------------------------------------
HENLEY_SUPPORT_EMAIL="care@henleytea.com"
HENLEY_FREE_SHIPPING_THRESHOLD_PAISE=100000
HENLEY_STANDARD_SHIPPING_PAISE=15000
HENLEY_EXPRESS_SHIPPING_PAISE=35000
HENLEY_COD_FEE_PAISE=5000
HENLEY_DEFAULT_GST_RATE=5.0

# ------------------------------------------------------------------------------
# Sail / Docker Ports
# ------------------------------------------------------------------------------
APP_PORT=80
VITE_PORT=5173
WWWUSER=1000
WWWGROUP=1000
